{
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/linkedin",    "destination": "https://www.linkedin.com/in/mohammed--alkindi/", "permanent": false },
    { "source": "/github",      "destination": "https://github.com/MohammedAlkindi/",          "permanent": false },
    { "source": "/memoir",      "destination": "/creative/memoir",                              "permanent": true  },
    { "source": "/photography", "destination": "/creative/photography",                         "permanent": true  },
    { "source": "/photography.html", "destination": "/creative/photography",                    "permanent": true  },
    { "source": "/systems",     "destination": "/projects",                                     "permanent": true  },
    { "source": "/systems.html","destination": "/projects",                                     "permanent": true  },

    { "source": "/(.*)", "has": [{ "type": "host", "value": "architectofsilence.com" }],     "destination": "https://alkindix.com/creative/memoir", "permanent": true },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "www.architectofsilence.com" }], "destination": "https://alkindix.com/creative/memoir", "permanent": true },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "photographyx.org" }],          "destination": "https://alkindix.com/creative/photography", "permanent": true },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "www.photographyx.org" }],      "destination": "https://alkindix.com/creative/photography", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options",  "value": "nosniff" },
        { "key": "X-Frame-Options",         "value": "DENY" },
        { "key": "X-XSS-Protection",        "value": "1; mode=block" },
        { "key": "Referrer-Policy",         "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",      "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
